<div class="news">
  {% if site.news != blank %}
    {% assign news_size = site.news | size %}
    <div
      class="news-list"
      {% if include.limit and site.announcements.scrollable and news_size > 3 %}
        style="max-height: 60vw"
      {% endif %}
    >
      {% assign news = site.news | reverse %}
      {% if include.limit and site.announcements.limit %}
        {% assign news_limit = site.announcements.limit %}
      {% else %}
        {% assign news_limit = news_size %}
      {% endif %}
      {% for item in news limit: news_limit %}
        <article class="news-item">
          {% if page.lang == 'zh' %}
            {% assign news_date = item.date | date: '%Y.%m.%d' %}
          {% else %}
            {% assign news_date = item.date | date: '%b %d, %Y' %}
          {% endif %}
          <time class="news-date" datetime="{{ item.date | date_to_xmlschema }}">{{ news_date }}</time>
          <div class="news-copy">
            {% if item.inline %}
              {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
            {% else %}
              {% if page.lang == 'zh' and item.zh_title %}
                {% assign item_title = item.zh_title %}
              {% else %}
                {% assign item_title = item.title %}
              {% endif %}
              <a class="news-title" href="{{ item.url | relative_url }}">{{ item_title }}</a>
            {% endif %}
          </div>
        </article>
      {% endfor %}
    </div>
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>
