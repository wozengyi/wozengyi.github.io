---
layout: default
---
<div class="post">
  <header class="post-header academic-hero">
    <div class="hero-copy">
      <p class="hero-kicker">{{ page.hero_kicker | default: 'VLM Agents · Post-training · Embodied AI' }}</p>
      <h1 class="post-title">
        {% if site.title == 'blank' %}
          <span class="font-weight-bold">{{ site.first_name }}</span> {{ site.middle_name }}
          {{ site.last_name }}
        {% else %}
          {{ site.title }}
        {% endif %}
      </h1>
      <p class="desc">{{ page.subtitle }}</p>
      {% if page.hero_summary %}<p class="hero-summary">{{ page.hero_summary }}</p>{% endif %}
      <nav class="hero-actions" aria-label="{{ page.hero_actions_label | default: 'Quick links' }}">
        <a class="hero-action-primary" href="{{ '/publications/' | relative_url }}">{{ page.hero_publications_label | default: 'Publications' }}</a>
        <a href="{{ '/cv/' | relative_url }}">{{ page.hero_cv_label | default: 'CV' }}</a>
        <a href="mailto:{{ site.email }}">{{ page.hero_email_label | default: 'Email me' }}</a>
      </nav>
    </div>
    {% if page.profile %}
      <div class="profile hero-profile">
        {% if page.profile.image %}
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          {% if page.profile.image_circular %}
            {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
          {% else %}
            {% assign profile_image_class = 'img-fluid z-depth-1' %}
          {% endif %}
          {% capture sizes %}(min-width: 768px) 290px, (min-width: 576px) 40vw, 80vw{% endcapture %}
          {%
            include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=page.profile.image_alt
            cache_bust=true
          %}
        {% endif %}
      </div>
    {% endif %}
  </header>

  <article>
    <div class="clearfix">{{ content }}</div>

    <!-- News -->
    {% if page.news and site.announcements.enabled %}
      <h2 class="section-heading">
        <a href="{{ '/news/' | relative_url }}" style="color: inherit">{{ page.news_heading | default: 'News' }}</a>
      </h2>
      {% include news.liquid limit=true %}
    {% endif %}

    <!-- Latest posts -->
    {% if site.latest_posts.enabled %}
      <h2 class="section-heading">
        <a href="{{ '/blog/' | relative_url }}" style="color: inherit">Latest Posts</a>
      </h2>
      {% include latest_posts.liquid %}
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <h2 class="section-heading">
        <a href="{{ '/publications/' | relative_url }}" style="color: inherit">{{ page.publications_heading | default: 'Selected Publications' }}</a>
      </h2>
      {% include selected_papers.liquid %}
    {% endif %}

    <!-- Honors & Awards -->
    {% if page.honors %}
      <h2 class="section-heading">{{ page.honors_heading | default: 'Honors & Awards' }}</h2>
      <ul class="academic-list">
        {% for item in page.honors %}
        <li>{{ item }}</li>
        {% endfor %}
      </ul>
    {% endif %}

    <!-- Academic Services -->
    {% if page.academic_services %}
      <h2 class="section-heading">{{ page.services_heading | default: 'Academic Services' }}</h2>
      <ul class="academic-list">
        {% for item in page.academic_services %}
        <li>{{ item }}</li>
        {% endfor %}
      </ul>
    {% endif %}

    <!-- Social -->
    {% if page.social %}
      <div class="social">
        <div class="contact-icons">{% include social.liquid %}</div>

        <div class="contact-note">{{ site.contact_note }}</div>
      </div>
    {% endif %}

    {% if site.newsletter.enabled and site.footer_fixed %}
      {% include scripts/newsletter.liquid center=true %}
    {% endif %}
  </article>
</div>
