---
layout: default
---

{% assign resume = site.data.resume %}

<style>
  .modern-cv {
    max-width: 900px !important;
    padding-top: 1.05rem !important;
  }

  .modern-cv .cv-hero {
    border-bottom: 1px solid var(--global-divider-color);
    margin-bottom: 1.35rem !important;
    padding: 1rem 0 1.2rem !important;
    position: relative !important;
  }

  .modern-cv .cv-hero::after {
    background: var(--global-theme-color) !important;
    bottom: -1px !important;
    content: "" !important;
    height: 2px !important;
    left: 0 !important;
    position: absolute !important;
    width: 5rem !important;
  }

  .modern-cv .hero-kicker {
    font-size: 0.72rem !important;
    margin-bottom: 0.45rem !important;
  }

  .modern-cv .cv-hero .post-title {
    font-size: 2.65rem !important;
    line-height: 1.08 !important;
    margin-bottom: 0.35rem !important;
  }

  .modern-cv .cv-hero .desc {
    font-size: 0.96rem !important;
    line-height: 1.45 !important;
    margin-bottom: 0.55rem !important;
  }

  .modern-cv .cv-contact {
    display: flex !important;
    flex-wrap: wrap !important;
    gap: 0.42rem !important;
  }

  .modern-cv .cv-contact a {
    border: 1px solid rgba(140, 29, 24, 0.18) !important;
    border-radius: 999px !important;
    color: var(--global-theme-color) !important;
    font-size: 0.78rem !important;
    font-weight: 700 !important;
    line-height: 1.2 !important;
    padding: 0.28rem 0.58rem !important;
    text-decoration: none !important;
    transition:
      background 0.18s ease,
      border-color 0.18s ease,
      color 0.18s ease !important;
  }

  .modern-cv .cv-contact a:hover {
    background: var(--global-theme-color) !important;
    border-color: var(--global-theme-color) !important;
    color: #fff !important;
  }

  .modern-cv .cv-section {
    border-bottom: 1px solid rgba(104, 112, 118, 0.18) !important;
    padding: 1.18rem 0 1.28rem !important;
  }

  .modern-cv .cv-section > h2,
  .modern-cv .cv-two-col h2 {
    border: 0 !important;
    color: var(--global-text-color) !important;
    font-family: Georgia, "Times New Roman", Times, serif !important;
    font-size: 1.15rem !important;
    line-height: 1.2 !important;
    margin: 0 0 0.72rem !important;
    padding: 0 !important;
  }

  .modern-cv .cv-section > h2::before,
  .modern-cv .cv-two-col h2::before {
    background: var(--global-theme-color) !important;
    content: "" !important;
    display: inline-block !important;
    height: 0.72rem !important;
    margin-right: 0.48rem !important;
    width: 0.18rem !important;
  }

  .modern-cv .cv-summary {
    padding-top: 0 !important;
  }

  .modern-cv .cv-summary p {
    font-size: 0.92rem !important;
    line-height: 1.62 !important;
    margin-bottom: 0.55rem !important;
    max-width: 760px !important;
  }

  .modern-cv .cv-timeline,
  .modern-cv .cv-publications {
    display: grid !important;
    gap: 0.82rem !important;
  }

  .modern-cv .cv-entry,
  .modern-cv .cv-publication {
    background: var(--global-card-bg-color) !important;
    border: 1px solid rgba(104, 112, 118, 0.14) !important;
    border-radius: 8px !important;
    display: grid !important;
    gap: 1rem !important;
    grid-template-columns: 6.9rem minmax(0, 1fr) !important;
    padding: 0.78rem 0.86rem !important;
  }

  .modern-cv .cv-date,
  .modern-cv .cv-venue {
    color: var(--global-theme-color) !important;
    font-size: 0.72rem !important;
    font-weight: 800 !important;
    line-height: 1.4 !important;
    padding-top: 0.04rem !important;
    text-transform: uppercase !important;
  }

  .modern-cv .cv-body h3,
  .modern-cv .cv-pub-body h3 {
    color: var(--global-text-color) !important;
    font-family: Georgia, "Times New Roman", Times, serif !important;
    font-size: 1rem !important;
    font-weight: 700 !important;
    line-height: 1.35 !important;
    margin: 0 0 0.12rem !important;
  }

  .modern-cv .cv-body h3 a,
  .modern-cv .cv-pub-body h3 a {
    color: inherit !important;
    text-decoration: none !important;
  }

  .modern-cv .cv-body h3 a:hover,
  .modern-cv .cv-pub-body h3 a:hover {
    color: var(--global-theme-color) !important;
    text-decoration: underline !important;
  }

  .modern-cv .cv-institution-joiner {
    color: var(--global-text-color-light) !important;
    display: inline-block !important;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Helvetica Neue", Arial, sans-serif !important;
    font-size: 0.86rem !important;
    font-weight: 650 !important;
    margin: 0 0.24rem !important;
  }

  .modern-cv .cv-body p,
  .modern-cv .cv-pub-body p {
    color: var(--global-text-color-light) !important;
    font-size: 0.88rem !important;
    line-height: 1.5 !important;
    margin: 0.12rem 0 0 !important;
  }

  .modern-cv .cv-role {
    color: var(--global-text-color) !important;
    font-weight: 650 !important;
  }

  .modern-cv .cv-meta {
    font-size: 0.83rem !important;
  }

  .modern-cv .cv-body ul {
    color: var(--global-text-color-light) !important;
    font-size: 0.86rem !important;
    margin: 0.28rem 0 0 !important;
    padding-left: 1rem !important;
  }

  .modern-cv .cv-tags {
    display: flex !important;
    flex-wrap: wrap !important;
    gap: 0.34rem !important;
  }

  .modern-cv .cv-tags span {
    background: rgba(140, 29, 24, 0.07) !important;
    border: 1px solid rgba(140, 29, 24, 0.16) !important;
    border-radius: 999px !important;
    color: var(--global-theme-color) !important;
    font-size: 0.72rem !important;
    font-weight: 750 !important;
    line-height: 1.2 !important;
    padding: 0.24rem 0.5rem !important;
  }

  .modern-cv .cv-tags-subtle {
    margin-top: 0.36rem !important;
  }

  .modern-cv .cv-tags-subtle span {
    background: transparent !important;
    border-color: rgba(104, 112, 118, 0.22) !important;
    color: var(--global-text-color-light) !important;
  }

  .modern-cv .cv-two-col {
    border-bottom: 0 !important;
    display: grid !important;
    gap: 1.8rem !important;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) !important;
  }

  .modern-cv .cv-plain-list {
    list-style: none !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  .modern-cv .cv-plain-list li {
    align-items: baseline !important;
    background: var(--global-card-bg-color) !important;
    border: 1px solid rgba(104, 112, 118, 0.14) !important;
    border-radius: 8px !important;
    display: grid !important;
    gap: 0.65rem !important;
    grid-template-columns: minmax(0, 1fr) auto !important;
    line-height: 1.45 !important;
    margin-bottom: 0.45rem !important;
    padding: 0.52rem 0.65rem !important;
  }

  .modern-cv .cv-plain-list span {
    font-size: 0.88rem !important;
  }

  .modern-cv .cv-plain-list em {
    color: var(--global-text-color-light) !important;
    font-size: 0.74rem !important;
    font-style: normal !important;
    font-weight: 800 !important;
  }

  .modern-cv .cv-skill + .cv-skill {
    margin-top: 0.75rem !important;
  }

  .modern-cv .cv-skill strong {
    display: block !important;
    font-family: Georgia, "Times New Roman", Times, serif !important;
    font-size: 0.95rem !important;
    margin-bottom: 0.16rem !important;
  }

  @media (max-width: 767px) {
    .modern-cv {
      padding-top: 0.85rem !important;
    }

    .modern-cv .cv-hero .post-title {
      font-size: 2.2rem !important;
    }

    .modern-cv .cv-entry,
    .modern-cv .cv-publication,
    .modern-cv .cv-two-col {
      gap: 0.3rem !important;
      grid-template-columns: 1fr !important;
    }
  }
</style>

<div class="post modern-cv">
  <header class="post-header cv-hero">
    <p class="hero-kicker">Curriculum Vitae</p>
    <h1 class="post-title">{{ resume.basics.name | default: page.title }}</h1>
    <p class="desc">{{ resume.basics.label }}</p>
    <div class="cv-contact">
      <a href="mailto:{{ resume.basics.email }}">{{ resume.basics.email }}</a>
      <a href="{{ resume.basics.url }}" target="_blank" rel="noopener noreferrer">{{ resume.basics.url }}</a>
      {% for profile in resume.basics.profiles %}
        <a href="{{ profile.url }}" target="_blank" rel="noopener noreferrer">{{ profile.network }}</a>
      {% endfor %}
    </div>
  </header>

  <article>
    <section class="cv-section cv-summary">
      <h2>Research Focus</h2>
      <p>{{ resume.basics.summary }}</p>
      <div class="cv-tags">
        {% for interest in resume.interests %}
          <span>{{ interest.name }}</span>
        {% endfor %}
      </div>
    </section>

    <section class="cv-section">
      <h2>Education</h2>
      <div class="cv-timeline">
        {% for item in resume.education %}
          <div class="cv-entry">
            <div class="cv-date">{{ item.displayDate }}</div>
            <div class="cv-body">
              <h3>
                <a href="{{ item.url }}" target="_blank" rel="noopener noreferrer">{{ item.institution }}</a>
                {% if item.jointInstitution and item.jointUrl %}
                  <span class="cv-institution-joiner">&amp;</span>
                  <a href="{{ item.jointUrl }}" target="_blank" rel="noopener noreferrer">{{ item.jointInstitution }}</a>
                {% endif %}
              </h3>
              <p class="cv-role">{{ item.studyType }}{% if item.area and item.area != '' %}, {{ item.area }}{% endif %}</p>
              {% if item.location %}<p class="cv-meta">{{ item.location }}</p>{% endif %}
              {% if item.courses and item.courses.size > 0 %}
                <ul>
                  {% for course in item.courses %}
                    <li>{{ course }}</li>
                  {% endfor %}
                </ul>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    </section>

    <section class="cv-section">
      <h2>Experience</h2>
      <div class="cv-timeline">
        {% for item in resume.work %}
          <div class="cv-entry">
            <div class="cv-date">{{ item.displayDate }}</div>
            <div class="cv-body">
              <h3><a href="{{ item.url }}" target="_blank" rel="noopener noreferrer">{{ item.name }}</a></h3>
              <p class="cv-role">{{ item.position }}</p>
              <p>{{ item.summary }}</p>
              {% if item.highlights and item.highlights.size > 0 %}
                <div class="cv-tags cv-tags-subtle">
                  {% for highlight in item.highlights %}
                    <span>{{ highlight }}</span>
                  {% endfor %}
                </div>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    </section>

    <section class="cv-section">
      <h2>Selected Publications</h2>
      <div class="cv-publications">
        {% for item in resume.publications %}
          <div class="cv-publication">
            <div class="cv-venue">{{ item.publisher }}</div>
            <div class="cv-pub-body">
              <h3><a href="{{ item.url }}" target="_blank" rel="noopener noreferrer">{{ item.name }}</a></h3>
              {% if item.summary and item.summary != '' %}<p>{{ item.summary }}</p>{% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    </section>

    <section class="cv-section cv-two-col">
      <div>
        <h2>Honors</h2>
        <ul class="cv-plain-list">
          {% for item in resume.awards %}
            <li>
              <span>{{ item.title }}</span>
              <em>{{ item.date | slice: 0, 4 }}</em>
            </li>
          {% endfor %}
        </ul>
      </div>
      <div>
        <h2>Skills</h2>
        {% for skill in resume.skills %}
          <div class="cv-skill">
            <strong>{{ skill.name }}</strong>
            <div class="cv-tags cv-tags-subtle">
              {% for keyword in skill.keywords %}
                <span>{{ keyword }}</span>
              {% endfor %}
            </div>
          </div>
        {% endfor %}
      </div>
    </section>
  </article>
</div>
